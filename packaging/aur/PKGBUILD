# Maintainer: TunaFish2K <i@2kb.fish>
# shellcheck shell=bash disable=SC2034,SC2154,SC2164

pkgbase=served
pkgname=(served served-systemd)
pkgver=0.4.1
pkgrel=1
pkgdesc='Lightweight per-user service manager'
arch=(x86_64 aarch64)
url='https://github.com/TunaFish2K/served'
license=(Unlicense)
makedepends=(cargo)
options=(!debug)
source=("served-$pkgver.tar.gz::$url/releases/download/v$pkgver/served-v$pkgver-source.tar.gz")
sha256sums=('59e9903f6064d5012930c7d233169561cbbb21be7e1b195beb9e50c3d27dc42c')

case "$CARCH" in
    x86_64) _target=x86_64-unknown-linux-gnu ;;
    aarch64) _target=aarch64-unknown-linux-gnu ;;
esac

prepare() {
    cd "served-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$_target"
}

build() {
    cd "served-$pkgver"
    export CARGO_TARGET_DIR=target
    export RUSTUP_TOOLCHAIN=stable
    cargo build --frozen --release --target "$_target"
}

check() {
    cd "served-$pkgver"
    export CARGO_TARGET_DIR=target
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --target "$_target"
}

package_served() {
    depends=(gcc-libs glibc)

    cd "served-$pkgver"
    install -Dm0755 "target/$_target/release/served" "$pkgdir/usr/bin/served"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/served/LICENSE"
    install -Dm0644 README.md "$pkgdir/usr/share/doc/served/README.md"
    install -Dm0644 README.zh-CN.md "$pkgdir/usr/share/doc/served/README.zh-CN.md"
}

package_served-systemd() {
    pkgdesc='systemd system-service template for served'
    arch=(any)
    depends=("served=$pkgver-$pkgrel" systemd)

    cd "served-$pkgver"
    sed 's|@SERVED_BIN@|/usr/bin/served|g' systemd/served@.service > served@.service
    install -Dm0644 served@.service "$pkgdir/usr/lib/systemd/system/served@.service"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/served-systemd/LICENSE"
}
