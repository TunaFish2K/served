[Unit]
Description=served system service manager
After=local-fs.target

[Service]
Type=simple
User=@SERVED_USER@
Group=@SERVED_GROUP@
Environment=HOME=%h
WorkingDirectory=%h
ExecStart=/bin/sh -lc 'exec /usr/local/bin/served daemon'
Restart=always
RestartSec=1s
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
