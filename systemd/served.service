[Unit]
Description=served system service manager
After=local-fs.target

[Service]
Type=simple
User=@SERVED_USER@
Group=@SERVED_GROUP@
SetLoginEnvironment=yes
WorkingDirectory=~
ExecStart=/bin/sh -lc 'exec /usr/local/bin/served daemon'
ExecStop=/usr/local/bin/served shutdown
ExecReload=/usr/local/bin/served daemon --handoff
Restart=always
RestartSec=1s
KillMode=process
TimeoutStopSec=30s
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
